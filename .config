# ============================================================================
# 斐讯 K3 (Phicomm K3) OpenWrt 精简配置
# 目标平台: bcm53xx (博通 BCM4709/BCM4366)
# ============================================================================

# ============================================================================
# 第一部分：硬件平台
# ============================================================================

CONFIG_TARGET_bcm53xx=y                # 选择博通53xx系列芯片平台
CONFIG_TARGET_bcm53xx_generic=y        # 选择通用子平台
CONFIG_TARGET_bcm53xx_generic_DEVICE_phicomm_k3=y  # 指定设备为斐讯K3
CONFIG_TARGET_BOARD="bcm53xx"          # 板卡名称

# ============================================================================
# 第二部分：内核支持
# ============================================================================

CONFIG_KERNEL_DEVMEM=y                 # 允许访问物理内存（K3屏幕需要）
CONFIG_KERNEL_MTD_NAND=y               # NAND闪存支持
CONFIG_KERNEL_MTD_SPI_NOR=y            # SPI NOR闪存支持

CONFIG_STRIP_KERNEL_EXPORTS=y          # 去除内核导出符号（减小体积）
CONFIG_USE_STRIP=y                     # 启用strip去除调试信息
CONFIG_USE_SSTRIP=y                    # 使用超级strip进一步减小体积
CONFIG_TARGET_OPTIMIZATION="-Os -pipe" # 针对体积优化编译
CONFIG_CCACHE=y                        # 启用编译缓存（第二次编译更快）
CONFIG_MAKE_JOBS=4                     # 编译时使用4线程

# ============================================================================
# 第三部分：系统基础组件
# ============================================================================

CONFIG_PACKAGE_base-files=y            # OpenWrt基础文件系统
CONFIG_PACKAGE_busybox=y               # 嵌入式Linux工具箱（ls/cp等命令）
CONFIG_PACKAGE_dnsmasq-full=y          # DNS和DHCP服务器（分配IP地址）
CONFIG_PACKAGE_dnsmasq_full_dhcp=y     # DHCP服务
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y   # IPv6 DHCP服务
CONFIG_PACKAGE_dnsmasq_full_ipset=y    # ipset支持（防火墙规则用）
CONFIG_PACKAGE_dnsmasq_full_tftp=y     # TFTP服务（网络启动用）
CONFIG_PACKAGE_dropbear=y              # SSH服务器（远程登录路由器）
CONFIG_PACKAGE_firewall=y              # 防火墙
CONFIG_PACKAGE_fstools=y               # 文件系统工具
CONFIG_PACKAGE_jsonfilter=y            # JSON命令行过滤工具
CONFIG_PACKAGE_libc=y                  # C标准库
CONFIG_PACKAGE_libgcc=y                # GCC运行时库
CONFIG_PACKAGE_libpthread=y            # 多线程支持库
CONFIG_PACKAGE_librt=y                 # 实时扩展库
CONFIG_PACKAGE_libstdcpp=y             # C++标准库
CONFIG_PACKAGE_logd=y                  # 日志服务
CONFIG_PACKAGE_mtd=y                   # 闪存操作工具（刷机用）
CONFIG_PACKAGE_netifd=y                # 网络接口管理守护进程
CONFIG_PACKAGE_nvram=y                 # NVRAM读写工具
CONFIG_PACKAGE_opkg=y                  # 软件包管理器（安装ipk）
CONFIG_PACKAGE_procd=y                 # 进程管理守护进程
CONFIG_PACKAGE_procd-ujail=y           # 进程沙箱隔离
CONFIG_PACKAGE_swconfig=y              # 交换机配置工具
CONFIG_PACKAGE_ubox=y                  # OpenWrt系统工具箱
CONFIG_PACKAGE_ubus=y                  # 进程间通信库
CONFIG_PACKAGE_ubusd=y                 # ubus守护进程
CONFIG_PACKAGE_uci=y                   # 统一配置接口
CONFIG_PACKAGE_urandom-seed=y          # 随机数种子（安全相关）
CONFIG_PACKAGE_urngd=y                 # 随机数生成器守护进程
CONFIG_PACKAGE_usign=y                 # 软件包签名工具

# ============================================================================
# 第四部分：IPv6 支持（如果不需要IPv6可注释掉）
# ============================================================================

CONFIG_PACKAGE_ipv6helper=y            # IPv6辅助工具
CONFIG_PACKAGE_odhcp6c=y               # IPv6 DHCP客户端
CONFIG_PACKAGE_odhcpd-ipv6only=y       # IPv6 DHCP服务器
CONFIG_PACKAGE_luci-proto-ipv6=y       # LuCI IPv6协议支持

# ============================================================================
# 第五部分：无线驱动（K3专用，不要改动）
# ============================================================================

CONFIG_PACKAGE_kmod-brcmfmac=y         # 博通无线网卡驱动
CONFIG_PACKAGE_kmod-brcmutil=y         # 博通无线工具库
# CONFIG_PACKAGE_brcmfmac-firmware-4366c0-pcie is not set  # K3的BCM4366无线芯片固件
CONFIG_PACKAGE_wpad-openssl=y          # WPA加密协议（WiFi密码加密）
CONFIG_PACKAGE_kmod-cfg80211=y         # Linux无线配置API
CONFIG_PACKAGE_kmod-mac80211=y         # Linux无线子系统
CONFIG_PACKAGE_hostapd-common=y        # WiFi接入点管理工具
CONFIG_PACKAGE_iw=y                    # 无线网络配置命令行工具
CONFIG_PACKAGE_iwinfo=y                # 无线信息查询工具
CONFIG_PACKAGE_wireless-regdb=y        # 无线频率法规数据库
CONFIG_PACKAGE_k3wifi=y                # K3专属WiFi优化脚本

# ============================================================================
# 第六部分：K3 屏幕驱动
# ============================================================================

CONFIG_PACKAGE_kmod-spi-gpio-custom=y  # SPI GPIO驱动（屏幕通信）
CONFIG_PACKAGE_k3screenctrl=y          # K3屏幕控制主程序
CONFIG_PACKAGE_luci-app-k3screenctrl=y # K3屏幕LuCI管理界面

# ============================================================================
# 第七部分：防火墙和网络工具
# ============================================================================

CONFIG_PACKAGE_luci-app-firewall=y     # LuCI防火墙管理界面
CONFIG_PACKAGE_ip-full=y               # ip命令完整版（配置网络）
CONFIG_PACKAGE_ipset=y                 # IP集合管理（防火墙规则）
CONFIG_PACKAGE_libipset=y              # ipset库文件

# iptables防火墙（代理插件需要）
CONFIG_PACKAGE_iptables=y              # Linux防火墙工具
CONFIG_PACKAGE_iptables-mod-extra=y    # iptables额外匹配模块
CONFIG_PACKAGE_iptables-mod-tproxy=y   # 透明代理支持（OpenClash需要）
CONFIG_PACKAGE_iptables-mod-iprange=y  # IP范围匹配
CONFIG_PACKAGE_iptables-mod-socket=y   # Socket匹配

# 内核防火墙模块
CONFIG_PACKAGE_kmod-ipt-extra=y        # iptables额外模块
CONFIG_PACKAGE_kmod-ipt-iprange=y      # IP范围匹配模块
CONFIG_PACKAGE_kmod-ipt-ipset=y        # IP集合匹配模块
CONFIG_PACKAGE_kmod-ipt-nat=y          # NAT网络地址转换
CONFIG_PACKAGE_kmod-ipt-nat6=y         # IPv6 NAT
CONFIG_PACKAGE_kmod-ipt-offload=y      # 硬件加速（提升转发性能）
CONFIG_PACKAGE_kmod-ipt-raw=y          # raw表支持
CONFIG_PACKAGE_kmod-ipt-socket=y       # socket匹配
CONFIG_PACKAGE_kmod-ipt-tproxy=y       # 透明代理支持

# Netfilter连接跟踪（NAT和防火墙需要）
CONFIG_PACKAGE_kmod-nf-conntrack=y     # 连接跟踪
CONFIG_PACKAGE_kmod-nf-conntrack6=y    # IPv6连接跟踪
CONFIG_PACKAGE_kmod-nf-flow=y          # 流卸载（加速）
CONFIG_PACKAGE_kmod-nf-ipt=y           # Netfilter iptables接口
CONFIG_PACKAGE_kmod-nf-ipt6=y          # IPv6 Netfilter接口
CONFIG_PACKAGE_kmod-nf-nat=y           # NAT支持
CONFIG_PACKAGE_kmod-nf-nat6=y          # IPv6 NAT
CONFIG_PACKAGE_kmod-nf-nathelper=y     # NAT辅助（如SIP语音）
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y  # 额外NAT辅助

# ============================================================================
# 第八部分：UPnP 自动端口转发
# ============================================================================
# UPnP：让游戏机、BT软件自动打开端口，无需手动设置

CONFIG_PACKAGE_miniupnpd=y             # UPnP服务端
CONFIG_PACKAGE_luci-app-upnp=y         # LuCI UPnP管理界面

# ============================================================================
# 第九部分：DDNS 动态域名解析
# ============================================================================
# DDNS：公网IP变化时自动更新域名，方便外网访问

CONFIG_PACKAGE_ddns-scripts=y          # DDNS脚本
CONFIG_PACKAGE_ddns-scripts_aliyun=y   # 阿里云DDNS支持
CONFIG_PACKAGE_ddns-scripts_dnspod=y   # DNSPod DDNS支持
CONFIG_PACKAGE_luci-app-ddns=y         # LuCI DDNS管理界面

# ============================================================================
# 第十部分：网络加速（Turbo ACC）
# ============================================================================
# Turbo ACC：硬件加速、BBR算法，提升网速降低延迟

CONFIG_PACKAGE_luci-app-turboacc=y     # Turbo ACC管理界面
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y  # BBR拥塞控制算法
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y  # 流量分载（降低CPU占用）

CONFIG_KERNEL_NET_SCH_FQ=y             # 公平队列调度
CONFIG_KERNEL_TCP_CONG_BBR=y           # BBR算法
CONFIG_PACKAGE_kmod-tcp-bbr=y          # BBR内核模块

# ============================================================================
# 第十一部分：DNS 分流工具（防DNS污染）
# ============================================================================

CONFIG_PACKAGE_mosdns=y                # MosDNS DNS分流主程序
CONFIG_PACKAGE_luci-app-mosdns=y       # MosDNS LuCI管理界面
CONFIG_PACKAGE_smartdns=y              # SmartDNS DNS缓存加速
CONFIG_PACKAGE_chinadns-ng=y           # ChinaDNS国内分流
CONFIG_PACKAGE_v2ray-geoip=y           # V2Ray地理IP数据库（用于分流）
CONFIG_PACKAGE_v2ray-geosite=y         # V2Ray地理网站数据库（用于分流）

# ============================================================================
# 第十二部分：代理插件（仅保留OpenClash）
# ============================================================================
# OpenClash：基于Clash的图形化代理客户端
# 支持 Shadowsocks、V2Ray、Trojan、WireGuard 等协议

CONFIG_PACKAGE_luci-app-openclash=y    # OpenClash LuCI界面
CONFIG_PACKAGE_libcap=y                # CAP库（权限管理）
CONFIG_PACKAGE_libcap-bin=y            # CAP命令行工具
CONFIG_PACKAGE_luci-lib-ipkg=y         # LuCI ipkg库
CONFIG_PACKAGE_luci-compat=y           # LuCI兼容库

# ============================================================================
# 第十三部分：USB 存储支持
# ============================================================================

# USB核心驱动
CONFIG_PACKAGE_kmod-usb-core=y         # USB核心驱动
CONFIG_PACKAGE_kmod-usb2=y             # USB 2.0驱动
CONFIG_PACKAGE_kmod-usb3=y             # USB 3.0驱动
CONFIG_PACKAGE_kmod-usb-ohci=y         # OHCI USB控制器（兼容旧设备）
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y     # xHCI USB控制器（USB 3.0）
CONFIG_PACKAGE_kmod-phy-bcm-ns-usb2=y  # 博通USB 2.0物理层驱动
CONFIG_PACKAGE_kmod-phy-bcm-ns-usb3=y  # 博通USB 3.0物理层驱动
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y  # USB指示灯触发
CONFIG_PACKAGE_kmod-usb-bcma=y         # BCMA USB总线

# USB存储设备
CONFIG_PACKAGE_kmod-usb-storage=y      # USB存储设备（U盘/移动硬盘）
CONFIG_PACKAGE_kmod-usb-storage-uas=y  # UAS协议（提升USB 3.0速度）

# 文件系统支持（读取不同格式的U盘）
CONFIG_PACKAGE_kmod-fs-ext4=y          # Linux ext4文件系统
CONFIG_PACKAGE_kmod-fs-vfat=y          # Windows FAT32文件系统
CONFIG_PACKAGE_kmod-fs-ntfs=y          # Windows NTFS文件系统

# 自动挂载
CONFIG_PACKAGE_block-mount=y           # 块设备挂载
CONFIG_PACKAGE_blockd=y                # 块设备守护进程

# Samba4文件共享（让电脑访问路由器上的U盘）
CONFIG_PACKAGE_luci-app-hd-idle=y      # 硬盘休眠（省电延长寿命）
CONFIG_PACKAGE_autosamba=y             # 自动Samba配置
CONFIG_PACKAGE_wsdd2=y                 # Windows网络发现服务


# ============================================================================
# 第十四部分：LuCI 基础（网页管理后台）
# ============================================================================

CONFIG_PACKAGE_luci=y                  # LuCI主程序
CONFIG_PACKAGE_luci-base=y             # LuCI基础库
CONFIG_PACKAGE_luci-compat=y           # 兼容库
CONFIG_PACKAGE_luci-mod-admin-full=y   # 完整管理界面
CONFIG_PACKAGE_luci-newapi=y           # LuCI新版API
CONFIG_PACKAGE_luci-lua-runtime=y      # Lua运行环境
CONFIG_LUCI_LANG_zh-cn=y               # 简体中文语言包

# ============================================================================
# 第十五部分：LuCI 常用应用
# ============================================================================

# ----- 基础工具 -----
CONFIG_PACKAGE_luci-app-autoreboot=y   # 定时重启（设置每周自动重启）
CONFIG_PACKAGE_luci-app-filetransfer=y # 文件传输（网页上传安装ipk包）
CONFIG_PACKAGE_luci-app-ttyd=y         # 网页终端（浏览器中输入Linux命令）
CONFIG_PACKAGE_luci-app-ramfree=y      # 内存清理（释放内存）
CONFIG_PACKAGE_luci-app-onliner=y      # 在线用户（查看WiFi连接的设备）
CONFIG_PACKAGE_luci-app-statistics=y   # 系统统计（CPU/内存/流量监控）
CONFIG_PACKAGE_luci-app-nlbwmon=y      # 网络流量监控（各设备流量统计）

# ----- 新增：上网时间控制 -----
# 功能：控制设备在指定时间段能否上网
# 用途：孩子上网管理、定时断网
CONFIG_PACKAGE_luci-app-accesscontrol=y  # 访问控制（上网时间管理）

# ----- 新增：OpenVPN 服务器 -----
# 功能：搭建VPN服务器，从外网安全访问内网
# 用途：远程访问家中设备、在外网安全上网
CONFIG_PACKAGE_luci-app-openvpn-server=y  # OpenVPN服务器LuCI专用界面

# ----- 新增：Socat 端口转发 -----
# 功能：TCP/UDP端口转发，支持IPv4/IPv6互相转发
# 用途：内网穿透、端口映射、IPv6转IPv4
CONFIG_PACKAGE_socat=y                 # Socat端口转发命令行工具

# ----- 可选：其他辅助插件（按需取消注释）-----
# CONFIG_PACKAGE_luci-app-wol=y         # 网络唤醒（远程开机电脑）
# CONFIG_PACKAGE_luci-app-vnstat=y      # vnStat流量统计
# CONFIG_PACKAGE_luci-app-sqm=y         # SQM智能限速（QoS流量整形）
# CONFIG_PACKAGE_luci-app-watchcat=y    # 看门狗（网络不通时自动重启）

# ============================================================================
# 第十六部分：LuCI 主题（界面皮肤）
# ============================================================================

CONFIG_PACKAGE_luci-theme-argon=y      # Argon主题（现代化扁平风格，推荐）
CONFIG_PACKAGE_luci-theme-bootstrap=y  # Bootstrap主题（默认，备用）

# ============================================================================
# 第十七部分：常用命令行工具
# ============================================================================

CONFIG_PACKAGE_bash=y                  # Bash Shell（更强大的命令行）
CONFIG_PACKAGE_curl=y                  # 网页下载工具（测试网络、下载文件）
CONFIG_PACKAGE_wget-ssl=y              # 下载工具（支持HTTPS）
CONFIG_PACKAGE_tar=y                   # 解压.tar文件
CONFIG_PACKAGE_gzip=y                  # 压缩/解压.gz文件
CONFIG_PACKAGE_unzip=y                 # 解压.zip文件
CONFIG_PACKAGE_htop=y                  # 进程管理器（比top更好用）
CONFIG_PACKAGE_nano=y                  # 文本编辑器（命令行中编辑配置文件）
CONFIG_PACKAGE_ca-certificates=y       # SSL证书（HTTPS需要）
CONFIG_PACKAGE_ca-bundle=y             # SSL证书包
CONFIG_PACKAGE_openssl-util=y          # OpenSSL工具（加密、证书管理）
CONFIG_PACKAGE_coreutils=y             # GNU核心工具
CONFIG_PACKAGE_coreutils-nohup=y       # nohup命令（后台运行）
CONFIG_PACKAGE_coreutils-base64=y      # base64编解码
CONFIG_PACKAGE_coreutils-od=y          # 八进制/十六进制查看
CONFIG_PACKAGE_ubi-utils=y             # UBI闪存工具（管理闪存分区）

# ============================================================================
# 第十八部分：内核模块（网络必需）
# ============================================================================

# 加密模块（代理、HTTPS需要）
CONFIG_PACKAGE_kmod-crypto-aead=y      # AEAD加密
CONFIG_PACKAGE_kmod-crypto-arc4=y      # RC4加密
CONFIG_PACKAGE_kmod-crypto-authenc=y   # 认证加密
CONFIG_PACKAGE_kmod-crypto-ecb=y       # ECB加密模式
CONFIG_PACKAGE_kmod-crypto-hash=y      # 哈希算法
CONFIG_PACKAGE_kmod-crypto-sha1=y      # SHA-1哈希
CONFIG_PACKAGE_kmod-crypto-user=y      # 用户态加密接口
CONFIG_PACKAGE_kmod-cryptodev=y        # 加密设备（硬件加速）

# 网络模块
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y  # GPIO按键热插拔
CONFIG_PACKAGE_kmod-leds-gpio=y        # GPIO LED灯
CONFIG_PACKAGE_kmod-lib-crc-ccitt=y    # CRC校验
CONFIG_PACKAGE_kmod-lib-textsearch=y   # 文本搜索库
CONFIG_PACKAGE_kmod-macvlan=y          # MAC VLAN（多拨用）
CONFIG_PACKAGE_kmod-nls-base=y         # 字符编码基础
CONFIG_PACKAGE_kmod-ppp=y              # PPP协议（拨号上网）
CONFIG_PACKAGE_kmod-mppe=y             # MPPE加密（PPTP用）
CONFIG_PACKAGE_kmod-pppoe=y            # PPPoE协议（宽带拨号）
CONFIG_PACKAGE_kmod-pppox=y            # PPPoX协议
CONFIG_PACKAGE_kmod-slhc=y             # SLIP压缩
CONFIG_PACKAGE_kmod-tun=y              # TUN虚拟网卡（VPN需要）
CONFIG_PACKAGE_kmod-sit=y              # IPv6-in-IPv4隧道
CONFIG_PACKAGE_kmod-inet-diag=y        # INET诊断
CONFIG_PACKAGE_kmod-netlink-diag=y     # Netlink诊断

# ============================================================================
# 第十九部分：PPPoE 拨号上网
# ============================================================================

CONFIG_PACKAGE_ppp=y                   # PPP拨号
CONFIG_PACKAGE_ppp-mod-pppoe=y         # PPPoE宽带拨号

# ============================================================================
# 第二十部分：被禁用的功能（减少体积）
# ============================================================================

# ----- 大型编程语言（路由器不需要）-----
# CONFIG_PACKAGE_node is not set        # Node.js（约10MB）
# CONFIG_PACKAGE_python3 is not set     # Python 3完整版（约8MB）
# CONFIG_PACKAGE_perl is not set        # Perl语言（约5MB）
# CONFIG_PACKAGE_ruby is not set        # Ruby语言（约6MB）
# CONFIG_PACKAGE_boost is not set       # Boost C++库（约10MB）

# ----- 其他代理插件（与OpenClash功能重叠）-----
# CONFIG_PACKAGE_luci-app-passwall is not set   # Passwall代理
# CONFIG_PACKAGE_luci-app-ssr-plus is not set   # SSR-Plus代理
# CONFIG_PACKAGE_luci-app-bypass is not set     # Bypass代理
# CONFIG_PACKAGE_luci-app-vssr is not set       # VSSR代理
# CONFIG_PACKAGE_luci-app-homeproxy is not set  # HomeProxy

# ----- 其他大型应用（按需开启）-----
CONFIG_PACKAGE_luci-app-adguardhome=y  # AdGuard广告过滤（约15MB）
# CONFIG_PACKAGE_luci-app-docker is not set       # Docker容器（约50MB）
# CONFIG_PACKAGE_luci-app-dockerman is not set    # Docker管理界面
# CONFIG_PACKAGE_luci-app-istorex is not set      # iStore应用商店
# CONFIG_PACKAGE_luci-app-store is not set        # 软件商店
# CONFIG_PACKAGE_luci-app-zerotier is not set     # ZeroTier虚拟组网
# CONFIG_PACKAGE_luci-app-vlmcsd is not set       # KMS激活服务
# CONFIG_PACKAGE_luci-app-squid is not set        # Squid代理缓存

# ============================================================================
# 第二十一部分：安全加固
# ============================================================================

CONFIG_USE_SSTRIP=y                    # 使用超级strip
CONFIG_SSTRIP_ARGS="-z"                # strip参数
CONFIG_PKG_CHECK_FORMAT_SECURITY=y     # 检查代码格式安全
CONFIG_PKG_ASLR_PIE_REGULAR=y          # 地址空间随机化（防攻击）
CONFIG_PKG_CC_STACKPROTECTOR_REGULAR=y # 栈保护（防溢出攻击）
CONFIG_KERNEL_CC_STACKPROTECTOR_REGULAR=y  # 内核栈保护
CONFIG_KERNEL_STACKPROTECTOR=y         # 内核栈保护
CONFIG_PKG_FORTIFY_SOURCE_1=y          # 强化源（安全）
CONFIG_PKG_RELRO_FULL=y                # RELRO保护（安全）
CONFIG_SECCOMP=y                       # seccomp沙箱（安全）

# ============================================================================
# 配置结束
# ============================================================================
